config SOC_SERIES_KW45X
	bool
	select SOC_FAMILY_KW

config SOC_SERIES
	default "kw45x" if SOC_SERIES_KW45X

config SOC_KW45B41Z83
	bool
	select SOC_SERIES_KW45X

config SOC
	default "kw45b41z83" if SOC_KW45B41Z83

config SOC_PART_NUMBER_KW45B41Z83AFTB
	bool

config SOC_PART_NUMBER
	default "KW45B41Z83AFTB" if SOC_PART_NUMBER_KW45B41Z83AFTB
